# Copy this file to .env and fill it in.
# DATABASE (MongoDB). Local default is used if this line is missing.
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/banana_vault
MONGODB_URI=mongodb://127.0.0.1:27017/banana_vault
# Secret used to sign the login cookie. Use a long random text.
JWT_SECRET=put-a-long-random-string-here
# Optional: use another Banana API address
# BANANA_API_URL=https://marcconrad.com/uob/banana/api.php?out=json

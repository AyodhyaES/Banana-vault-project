# Copy this file to .env and fill in your own values. NEVER upload .env to GitHub.
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/banana_vault
JWT_SECRET=change_this_to_a_long_random_text

# Email (needed to send the 6-digit codes). Gmail example:
#  1) Google Account > Security > turn on 2-Step Verification
#  2) Google Account > Security > App passwords > make one (16 letters)
#  3) Write the 16 letters below WITHOUT spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM="Banana Mystery Vault <yourname@gmail.com>"
